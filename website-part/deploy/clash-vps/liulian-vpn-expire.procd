#!/bin/sh /etc/rc.common
# Install at /etc/init.d/liulian-vpn-expire on OpenWrt VPN hosts only.
START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/node /opt/liulian-vpn/expire-daemon.js
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param user root
    procd_close_instance
}
