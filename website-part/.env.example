NODE_ENV=development
PORT=3000
BIND_IP=127.0.0.1
SESSION_COOKIE_NAME=connect.sid
SESSION_SECRET=replace-with-a-long-random-value
# Require account holders to explicitly accept the Terms of Service and data-storage notice.
TERMS_OF_SERVICE_REQUIRED=true
PROXY_ALLOW_SELF_SIGNED=false
# Comma-separated user groups allowed to use SSH and RDP. Defaults to admin when unset.
REMOTE_ALLOWED_GROUPS=admin
# Set either feature to false to disable it for every user, including administrators.
REMOTE_SSH_ENABLED=true
REMOTE_RDP_ENABLED=true
# Comma-separated SSH hosts or IPv4 CIDR ranges permitted by the server. Leave empty only on a trusted network.
# Example: 192.168.1.0/24,10.0.0.5
SSH_ALLOWED_HOSTS=
# Base64-encoded 32-byte key for AES-256-GCM server-side remote-profile storage.
# Generate with: openssl rand -base64 32
REMOTE_CREDENTIAL_ENCRYPTION_KEY=
# Hyperbeam virtual Chromium. Keep the API key server-side and never expose it to the browser.
HYPERBEAM_API_KEY=
HYPERBEAM_API_URL=https://engine.hyperbeam.com/v0/vm
HYPERBEAM_REGION=AS
