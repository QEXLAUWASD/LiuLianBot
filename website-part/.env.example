NODE_ENV=development
PORT=3000
BIND_IP=127.0.0.1
SESSION_COOKIE_NAME=connect.sid
SESSION_SECRET=replace-with-a-long-random-value
# Require account holders to explicitly accept the Terms of Service and data-storage notice.
TERMS_OF_SERVICE_REQUIRED=true
PROXY_ALLOW_SELF_SIGNED=false
# Comma-separated user groups allowed to use SSH and RDP. Defaults to admin when unset.
REMOTE_ALLOWED_GROUPS=admin
# Set either feature to false to disable it for every user, including administrators.
REMOTE_SSH_ENABLED=true
REMOTE_RDP_ENABLED=true
# Comma-separated SSH hosts or IPv4 CIDR ranges permitted by the server. Leave empty only on a trusted network.
# Example: 192.168.1.0/24,10.0.0.5
SSH_ALLOWED_HOSTS=
# Base64-encoded 32-byte key for AES-256-GCM server-side remote-profile storage.
# Generate with: openssl rand -base64 32
REMOTE_CREDENTIAL_ENCRYPTION_KEY=
# Server-side Chromium. Set this to an installed Chrome/Chromium executable when it is not on PATH.
CHROME_EXECUTABLE_PATH=
# OpenWrt mode: connect to Chrome running on another machine instead of launching locally.
# Example: http://192.168.1.10:9222
CHROME_CDP_URL=
# Maximum lifetime of one browser WebSocket session in milliseconds.
CHROMIUM_SESSION_TIMEOUT_MS=1800000
# Interim VLESS listener settings. The listener must route to
# VLESS_TUNNEL_INTERNAL_TARGET; the website only emits client configuration.
VLESS_TUNNEL_ADDRESS=
VLESS_TUNNEL_PORT=443
VLESS_TUNNEL_UUID=
VLESS_TUNNEL_NETWORK=tcp
VLESS_TUNNEL_SECURITY=tls
# Set to reality for XTLS Vision/Reality. Required when security=reality.
VLESS_TUNNEL_REALITY_PUBLIC_KEY=
VLESS_TUNNEL_REALITY_SHORT_ID=
VLESS_TUNNEL_CLIENT_FINGERPRINT=chrome
VLESS_TUNNEL_SNI=
VLESS_TUNNEL_PATH=/
VLESS_TUNNEL_HOST=
VLESS_TUNNEL_FLOW=
VLESS_TUNNEL_REMARK=LiuLianBot interim internal tunnel
VLESS_TUNNEL_INTERNAL_TARGET=web server internal network
VLESS_TUNNEL_TTL_SECONDS=3600
VLESS_TUNNEL_ALLOW_INSECURE=false
